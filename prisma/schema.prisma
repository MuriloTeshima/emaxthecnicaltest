generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContactKind {
  CLIENT
  SUPPLIER
  BOTH
}

enum OperationType {
  DOMESTIC
  EU_GOODS
  EU_SERVICES
}

enum PaymentStatus {
  PENDING
  PAID
}

enum DocumentSource {
  MANUAL
  OCR
}

model Company {
  id             String     @id @default(cuid())
  name           String
  nif            String
  address        String?
  invoiceSeries  String     @default("F")
  createdAt      DateTime   @default(now())
  contacts       Contact[]
  invoices       Invoice[]
  expenses       Expense[]
  documents      Document[]
}

model Contact {
  id             String      @id @default(cuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind           ContactKind
  name           String
  nif            String
  country        String      @default("ES") // ISO 3166-1 alpha-2
  email          String?
  address        String?
  isProfessional Boolean     @default(false) // supplier subject to IRPF withholding
  createdAt      DateTime    @default(now())
  invoices       Invoice[]
  expenses       Expense[]

  @@index([companyId, kind])
  @@index([companyId, nif])
}

model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact       @relation(fields: [contactId], references: [id])
  number        String
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date
  operationType OperationType @default(DOMESTIC)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?     @db.Date
  notes         String?
  createdAt     DateTime      @default(now())
  lines         InvoiceLine[]

  @@unique([companyId, number])
  @@index([companyId, issueDate])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int
  description    String
  quantity       Decimal @db.Decimal(12, 3)
  unitPriceCents Int
  vatRate        Int // percent: 21, 10, 4, 0
}

model Expense {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Contact        @relation(fields: [supplierId], references: [id])
  number        String?
  date          DateTime       @db.Date
  concept       String
  category      String         @default("general")
  baseCents     Int
  vatRate       Int
  vatCents      Int
  irpfRate      Int            @default(0)
  irpfCents     Int            @default(0)
  totalCents    Int // base + vat - irpf
  deductible    Boolean        @default(true)
  operationType OperationType  @default(DOMESTIC)
  status        PaymentStatus  @default(PENDING)
  paidAt        DateTime?      @db.Date
  source        DocumentSource @default(MANUAL)
  documentId    String?        @unique
  document      Document?      @relation(fields: [documentId], references: [id])
  createdAt     DateTime       @default(now())

  @@index([companyId, date])
}

model Document {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  sizeBytes   Int
  url         String?
  ocrProvider String
  ocrRaw      Json
  createdAt   DateTime @default(now())
  expense     Expense?
}
